CREATE TABLE clientes(
  id_clientes INT PRIMARY KEY,
  nome VARCHAR (20),
  telefone VARCHAR(10),
  email VARCHAR(50)
 );
  INSERT INTO Clientes(id_clientes, nome, telefone, email)
  VALUES
  (00, 'Bárbara' , '+55 31 7002-9008', 'barbara@atividade.com'),
