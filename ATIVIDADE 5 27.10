DROP TABLE IF EXISTS Matriculas;
DROP TABLE IF EXISTS Curso;
DROP TABLE IF EXISTS Alunos;

CREATE TABLE Alunos (
    id_aluno INT PRIMARY KEY,
    nome VARCHAR(100),
    cpf VARCHAR(14),
    data_nasc DATE,
    telefone VARCHAR(20)
);

INSERT INTO Alunos (id_aluno, nome, cpf, data_nasc, telefone)
VALUES
