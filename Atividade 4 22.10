CREATE TABLE Filmes (
    id_filme INT PRIMARY KEY,
    titulo VARCHAR(50),
    genero VARCHAR(20),
    ano_lancamento INT,
    classificacao_etaria VARCHAR(10)
);

INSERT INTO Filmes
    (id_filme, titulo, genero, ano_lancamento, classificacao_etaria)
VALUES
    (1, 'Vingadores Doomsday', 'Ação', 2026, '16+'),
    (2, 'A Volta dos Que Não Foram', 'Comédia', 1995, 'L'),
