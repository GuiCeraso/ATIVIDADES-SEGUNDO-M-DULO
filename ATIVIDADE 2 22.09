CREATE TABLE clientes(
  id_cliente INTEGER PRIMARY KEY,
  nome VARCHAR (20),
  telefone VARCHAR(10)
  );
  INSERT INTO clientes(id_cliente, nome, telefone)
    VALUES
    (1,'Ana', '99999-1111'),
    (2,'Carlos', '99999-2222'),
    (3,'Julia', '99999-3333');
CREATE TABLE pedidos(
    id_pedido INT PRIMARY KEY,
    data_pedido VARCHAR(10),
    valor VARCHAR(8),
    id_cliente INT,
    FOREIGN KEY(id_cliente)REFERENCES clientes(id_cliente)
    );
   	INSERT INTO pedidos(id_pedido, data_pedido, valor, id_cliente)
   	VALUES
