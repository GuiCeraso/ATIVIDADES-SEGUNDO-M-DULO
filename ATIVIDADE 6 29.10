CREATE TABLE Dados(
    ID INT AUTO_INCREMENT PRIMARY KEY,
    Nome VARCHAR(100),
    Email VARCHAR(100),
    Forma_Pagamento VARCHAR(50)
);

INSERT INTO Dados(Nome, Email, Forma_Pagamento)
VALUES
    ('GUILHERME', 'GUILHERMECERASO@HOTMAIL.COM', 'PIX'),
    ('MANUEL', 'MANUELGOMES@GMAIL.COM', 'DINHEIRO');


CREATE TABLE EVENTOS(
    ID_EVENTO INT AUTO_INCREMENT PRIMARY KEY,
    TIPO_DE_EVENTO VARCHAR(30),
    DATA DATE,
    QUANTIDADE_DE_PESSOAS VARCHAR(3),
    LOCAL VARCHAR(30)
);

INSERT INTO EVENTOS(TIPO_DE_EVENTO, DATA, QUANTIDADE_DE_PESSOAS, LOCAL)
VALUES
    ('CASAMENTO E FESTA', '2026-07-30', '100', 'IGREJA E SALÃO'),
    ('FESTA DE ANIVERSÁRIO', '2027-01-03', '30', 'PARQUE DE DIVERSÕES');


CREATE TABLE AGENDA(
    ID_AGENDA INT AUTO_INCREMENT PRIMARY KEY,
    DISPONIVEL VARCHAR(3)
);

INSERT INTO AGENDA(DISPONIVEL)
VALUES
    ('SIM'),
    ('SIM');


CREATE TABLE SERVIÇOS(
    ID_PEDIDO INT AUTO_INCREMENT PRIMARY KEY,
    ANIMACAO_FESTA VARCHAR(3),
    BUFFET VARCHAR(3),
    FANTASIA VARCHAR(3),
    BEBIDA VARCHAR(3),
    FOTOGRAFIA VARCHAR(3),
    MUSICA VARCHAR(3)
);

INSERT INTO SERVIÇOS(
    ANIMACAO_FESTA, BUFFET, FANTASIA,
    BEBIDA, FOTOGRAFIA, MUSICA
)
VALUES
    ('SIM', 'SIM', 'NÃO', 'SIM', 'SIM', 'SIM'),
    ('SIM', 'SIM', 'SIM', 'SIM', 'SIM', 'SIM');


CREATE TABLE PAGAMENTO(
    ID_PAGAMENTO INT AUTO_INCREMENT PRIMARY KEY,
    ID INT,
    ID_EVENTO INT,
    ID_AGENDA INT,
    ID_PEDIDO INT,
    PAGAMENTO_FEITO VARCHAR(10),

    FOREIGN KEY (ID) REFERENCES Dados(ID),
    FOREIGN KEY (ID_EVENTO) REFERENCES EVENTOS(ID_EVENTO),
    FOREIGN KEY (ID_AGENDA) REFERENCES AGENDA(ID_AGENDA),
    FOREIGN KEY (ID_PEDIDO) REFERENCES SERVIÇOS(ID_PEDIDO)
);

INSERT INTO PAGAMENTO(
    ID, ID_EVENTO, ID_AGENDA, ID_PEDIDO, PAGAMENTO_FEITO
)
VALUES
    (1, 1, 1, 1, 'SIM'),
    (2, 2, 2, 2, 'SIM');


