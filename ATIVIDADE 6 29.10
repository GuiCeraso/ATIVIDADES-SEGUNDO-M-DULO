CREATE TABLE Dados(
    ID INT AUTOINCREMENT PRIMARY KEY,
    Nome VARCHAR(100),
    Email VARCHAR(100),
    Forma_Pagamento VARCHAR(50)
);
INSERT INTO Dados(Nome, Email,Forma_Pagamento)
VALUES
	('GUILHERME', 'GUILHERMECERASO@HOTMAIL.COM', 'PIX'),
    ('MANUEL', 'MANUELGOMES@GMAIL.COM', 'DINHEIRO');
CREATE TABLE EVENTOS(
  ID_EVENTO INT AUTOINCREMENT PRIMARY KEY,
  TIPO_DE_EVENTO VARCHAR (30),
  DATA DATE,
  QUANTIDADE_DE_PESSOAS VARCHAR (3)
  LOCAL VARCHAR (30)
);
INSERT INTO EVENTOS(TIPO_DE_EVENTO, DATA, QUANTIDADE_DE_PESSOAS, LOCAL)
VALUES
	('CASAMENTO E FESTA', '2026-07-30', '100', 'IGREJA E SALÃO'),
    ('FESTA DE ANIVERSÁRIO', '2027-01-03', '30', 'PARQUE DE DIVERSÕES');
CREATE TABLE AGENDA(
  ID_AGENDA INT AUTOINCREMENT PRIMARY KEY,
  DISPONIVEL VARCHAR (3)
);
INSERT INTO AGENDA(DISPONIVEL)
VALUES
	('SIM'),
    ('SIM');
CREATE TABLE SERVIÇOS(
  ID_PEDIDO INT AUTOINCREMENT PRIMARY KEY,
  ANIMAÇÃO_FESTA VARCHAR(3),
  BUFFET VARCHAR(3),
  FANTASIA VARCHAR(3),
  BEBIDA VARCHAR(3),
  FOTOGRAFIA VARCHAR(3),
  MUSICA VARCHAR(3)
);
INSERT INTO SERVIÇOS(ANIMAÇÃO_FESTA,BUFFET,FANTASIA,BEBIDA,FOTOGRAFIA,MUSICA)
VALUES
	('SIM', 'SIM', 'NÃO', 'SIM', 'SIM', 'SIM'),
    ('SIM', 'SIM', 'SIM', 'SIM', 'SIM', 'SIM');
CREATE TABLE PAGAMENTO(
  ID_PAGAMENTO INT AUTOINCREMENT PRIMARY KEY,
  ID INT AUTOINCREMENT,
  ID_EVENTO INT AUTOINCREMENT,
  ID_AGENDA INT AUTOINCREMENT,
  ID_PEDIDO INT AUTOINCREMENT,
  FOREIGN KEY (Dados)
  	REFERENCES(ID)
  FOREIGN KEY (EVENTOS)
  	REFERENCES (ID_EVENTO)
  FOREIGN KEY (AGENDA)
  	REFERENCES (ID_AGENDA)
  FOREIGN (SERVIÇOS)
  	REFERENCES (ID_PEDIDO)
);
